#!/bin/bash
# Fixed-verb root helper for the PiBuddyCam appliance (WP-R1, AC-17/B3).
#
# The unprivileged pibuddycam service account is allowed by
# /etc/sudoers.d/pibuddycam to run ONLY this script. Sudoers entries that list a
# command without arguments permit ANY arguments, so this script validates the
# verb itself and exposes nothing else: an unknown verb exits 2 before any
# privileged command runs.
#
# Verbs:
#   start-camera         systemctl start pibuddycam.target
#   stop-provisioning    systemctl stop pibuddycam-provisioning.service
#   hotspot-start        hotspot_ctl.py start  (setup AP, 192.168.4.1/24)
#   hotspot-stop         hotspot_ctl.py stop
#   wifi-station-apply   wifi_station.py apply <ssid>, PSK read from stdin
#   install-update       systemctl start pibuddycam-updater-install.service
#   check-update         systemctl start pibuddycam-updater.service (report-only)
#   reboot               systemctl reboot
#   rtsp-start           systemctl start pibuddycam-rtsp.service
#   rtsp-stop            systemctl stop pibuddycam-rtsp.service
#   quality-restart      restart source/HA RTSP, try-restart Prusa RTSP
#
# The Wi-Fi PSK is never an argument: it is forwarded on stdin to
# wifi_station.py, which writes it to a 0600 NetworkManager ``passwd-file`` and
# activates the profile with `nmcli connection up ... passwd-file <file>`.
#
# PIBUDDYCAM_APP_ROOT exists only so host tests can stub the application root; a
# real sudo invocation resets the environment (env_reset is pinned in
# /etc/sudoers.d/pibuddycam), so it cannot redirect the helper.
set -eu

APP_ROOT="${PIBUDDYCAM_APP_ROOT:-/opt/pibuddycam}"
PYTHON="$APP_ROOT/venv/bin/python"

# Absolute path: the helper must not depend on the caller's PATH (secure_path is
# pinned in the sudoers drop-in, but do not rely on it for a root command).
SYSTEMCTL=/usr/bin/systemctl

verb="${1:-}"
case "$verb" in
   start-camera)
      # --no-block: the target Conflicts= pibuddycam-provisioning.service, so a
      # blocking start deadlocks when called from within provisioning itself
      # (provisioning can't exit while its subprocess waits for the target,
      # and the target can't activate until provisioning exits).  The caller
      # (privileged.start_camera) polls is-active after the --no-block start.
      exec "$SYSTEMCTL" --no-block start pibuddycam.target
      ;;
   stop-provisioning)
      exec "$SYSTEMCTL" stop pibuddycam-provisioning.service
      ;;
   install-update)
      exec "$SYSTEMCTL" start pibuddycam-updater-install.service
      ;;
   check-update)
      # Report-only: pibuddycam-updater.service runs ``updater_install.py check`` and
      # never installs. The admin UI's manual check starts this fixed unit.
      exec "$SYSTEMCTL" start pibuddycam-updater.service
      ;;
   reboot)
      exec "$SYSTEMCTL" reboot
      ;;
   rtsp-start)
      exec "$SYSTEMCTL" start pibuddycam-rtsp.service
      ;;
   rtsp-stop)
      exec "$SYSTEMCTL" stop pibuddycam-rtsp.service
      ;;
   quality-restart)
      "$SYSTEMCTL" restart rpicam-source.service pibuddycam-ha-rtsp.service
      exec "$SYSTEMCTL" try-restart pibuddycam-rtsp.service
      ;;
   hotspot-start)
      exec "$PYTHON" "$APP_ROOT/hotspot_ctl.py" start
      ;;
   hotspot-stop)
      exec "$PYTHON" "$APP_ROOT/hotspot_ctl.py" stop
      ;;
   wifi-station-apply)
      ssid="${2:-}"
      if [ -z "$ssid" ]; then
         exit 2
      fi
      exec "$PYTHON" "$APP_ROOT/wifi_station.py" apply "$ssid"
      ;;
   *)
      exit 2
      ;;
esac
