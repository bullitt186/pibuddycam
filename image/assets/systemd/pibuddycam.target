# Image-only runtime target (AC-12). Groups and orders the reused
# app/systemd units per source §3.2:
#
#   data-ready.target -> pibuddycam.target
#     -> pi-persist -> rpicam-source -> pibuddycam-rtsp -> pibuddycam-ha-rtsp -> pibuddycam
#
# Intra-service ordering is already encoded in the reused unit files
# (pi-persist Before the camera units; pibuddycam-rtsp/pibuddycam-ha-rtsp After
# rpicam-source). This target adds the explicit data-ready gate and the
# grouping so later WPs (MQTT/admin/updater) attach here.
[Unit]
Description=PiBuddyCam runtime target (source, signaling, RTSP, admin)
Requires=data-ready.target
After=data-ready.target
# The setup runtime and the camera runtime are mutually exclusive (AC-12): the
# wizard's finish step starts this target, which stops pibuddycam-provisioning.service.
# Ordering after it (AC-18) means the camera units cannot start while the
# provisioning process — which may still hold the sensor during QR capture/probe
# — is shutting down.
Conflicts=pibuddycam-provisioning.service
After=pibuddycam-provisioning.service

# Reused units, activated and awaited by this target. pibuddycam-admin.service is
# pulled here (its [Install] WantedBy=pibuddycam.target), so the admin UI is
# only reachable after claim. pibuddycam-updater.timer (WP-R4b) is pulled with Wants=
# so the update check is available after claim without gating camera startup.
Wants=pi-persist.service rpicam-source.service pibuddycam-rtsp.service pibuddycam-ha-rtsp.service pibuddycam.service pibuddycam-admin.service pibuddycam-updater.timer
After=pi-persist.service rpicam-source.service pibuddycam-rtsp.service pibuddycam-ha-rtsp.service pibuddycam.service pibuddycam-admin.service

# Optional units (pibuddycam-mqtt.service; added by later WPs) must be Wants=, never
# Requires=, so a WS-Discovery/MQTT/admin/update failure never stops the source,
# Prusa registration/signaling, snapshots, RTSP, or WebRTC (AC-27). The updater
# timer above is likewise optional and isolated.

[Install]
WantedBy=multi-user.target
