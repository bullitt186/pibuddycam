# Post-claim admin HTTP UI (admin_app.py), the thin aiohttp transport over the
# stdlib admin_http core. Binds :443 over HTTPS at
# https://pibuddycam-<device-id>.local. The port is below 1024, so
# CAP_NET_BIND_SERVICE is required.
#
# This unit is pulled by pibuddycam.target (its [Install]
# WantedBy=pibuddycam.target), so the admin UI is only reachable after claim.
# The pre-claim captive portal is served by pibuddycam-provisioning.service instead,
# bound to the setup hotspot at http://192.168.4.1.
#
# TLS is mandatory: pi-persist.service (Before= this unit) provisions the durable
# keypair and recreates /etc/pibuddycam/admin.env with ADMIN_TLS_CERT/ADMIN_TLS_KEY
# on every boot. admin_app.py fails closed when they are missing or invalid, so
# this unit never serves plaintext HTTP on :443.
# data-ready.target gates this unit on a real, writable PERSIST /data mount (AC-7).
[Unit]
Description=PiBuddyCam admin / provisioning UI
After=network-online.target data-ready.target
Wants=network-online.target
Requires=data-ready.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pibuddycam
WorkingDirectory=/opt/pibuddycam
Environment=ADMIN_MODE=admin
# The local live monitor runs GStreamer in this process. Without a writable cache the plugin
# registry is rescanned on every capture (~12 s on a Zero 2 W) and no frame ever arrives.
Environment=XDG_CACHE_HOME=/tmp/pibuddycam
EnvironmentFile=-/etc/pibuddycam/admin.env
# WP-R4c: start through the launcher so an installed signed release under DATA
# (and its per-release venv) runs; the launcher falls back to the factory app.
ExecStart=/opt/pibuddycam/launcher.sh admin_app.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=pibuddycam.target
