# ── Secrets / live credentials — never commit ────────────────────────────
config.ini
.env
*.env
!*.env.example
tokens.json

# ── Local tooling artifacts (not part of the project) ─────────────────────
.opencode/
.playwright-mcp/
.playwright-cli/

# ── Personal agent runbooks (real host/network details) ───────────────────
# Keep the redacted *.example.md templates; ignore the filled-in local copies.
.agent/*
!.agent/*.example.md
*.local.md
*token*.conf

# ── Firmware & decompilation artifacts — excluded for IP reasons ──────────
# (see docs/sources.md — the firmware is referenced, never redistributed)
*.img
*.tar
*.gzf
lp_app*
*.bin
oem_extracted/
ghidrassist_*.db

# ── Reverse-engineering capture data (may contain account tokens) ─────────
*.har
api/

# ── Screenshots (excluded: contain live tokens + private imagery) ─────────
*.png
*.jpg
*.jpeg
# The image's placeholder icon is a synthetic asset the build and tests require.
!image/assets/icon/pibuddycam.png

# ── Playwright failure diagnostics (synthetic fixture only) ───────────────
tests/e2e/.artifacts/

# ── Rust build output ─────────────────────────────────────────────────────
target/
**/target/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
venv/
.venv/

# ── Tooling / OS ──────────────────────────────────────────────────────────
.DS_Store
.codegraph/
.codex/*
!.codex/config.toml
