# The impersonator itself (main.py): registers to Prusa Connect, uploads
# /c/info + snapshots, runs signaling + WebRTC. Binds :80 via CAP_NET_BIND_SERVICE.
# data-ready.target gates this unit on a real, writable PERSIST /data mount (AC-7).
[Unit]
Description=PiBuddyCam camera runtime
After=network-online.target data-ready.target
Wants=network-online.target
Requires=data-ready.target

[Service]
AmbientCapabilities=CAP_NET_BIND_SERVICE
Type=simple
User=pibuddycam
# WP-UI2/AC-4: systemd creates the service-owned runtime directory that holds
# the bounded local control socket (/run/pibuddycam/control.sock). Both the
# camera and admin units run as pibuddycam; the socket itself is mode 0600.
RuntimeDirectory=pibuddycam
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/pibuddycam
# GStreamer/fontconfig need a writable cache (HOME is read-only on the appliance).
Environment=XDG_CACHE_HOME=/tmp/pibuddycam
# WP-R4c: start through the launcher so an installed signed release under DATA
# (and its per-release venv) runs; the launcher falls back to the factory app.
ExecStart=/opt/pibuddycam/launcher.sh main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
