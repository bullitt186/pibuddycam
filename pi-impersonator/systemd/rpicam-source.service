# Persistent H264 camera source. rpicam-vid writes to stdout; stream_mux.py multiplexes
# that stream to any number of TCP clients on port 8888 (RTSP server, snapshot code, etc.)
# Resolution is driven by the VideoQuality tier:
# main.py writes /etc/prusa-cam/quality.env (CAM_WIDTH/CAM_HEIGHT) and restarts this unit.
# quality.live.env is an ephemeral live override (GAP-QUALITY-02); it is read last so a
# live change moves the encoder without touching the persisted tier.
# rotation.env (CAM_ROTATION, 0/90/180/270 clockwise) is the web-console rotation
# setting; it is independent of the quality files so a tier change keeps it.
# camera_source.py (from the active app release via launcher.sh) builds the pipeline:
# rpicam-vid --rotation for 0/180, a libcamerasrc GStreamer source for 90/270, piped
# into stream_mux.py. rpicam-vid runs with -v 0 (level-1 frame stats flood the journal)
# and --intra 30 --flush for lower latency.
# data-ready.target gates this unit on a real, writable PERSIST /data mount (AC-7).
[Unit]
Description=Persistent H264 camera source (TCP)
After=network.target data-ready.target
Requires=data-ready.target

[Service]
Type=simple
User=prusa-cam
Environment=CAM_WIDTH=1920 CAM_HEIGHT=1080 CAM_ROTATION=0
EnvironmentFile=-/etc/prusa-cam/quality.env
EnvironmentFile=-/etc/prusa-cam/quality.live.env
EnvironmentFile=-/etc/prusa-cam/rotation.env
ExecStart=/opt/prusa-cam/launcher.sh camera_source.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
